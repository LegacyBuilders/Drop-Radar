# Drop Radar — environment variables.
# Copy to .env.local for local dev, set in Vercel for production.

# --- InstantDB (https://instantdb.com) ---
# Public — exposed to the browser via Vite.
VITE_INSTANT_APP_ID=

# Server-only — used by Vercel serverless functions in /api/*.
INSTANT_APP_ID=
INSTANT_ADMIN_TOKEN=

# --- Stripe (https://dashboard.stripe.com) ---
# Test keys for local; live keys for prod.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Phase 1: Stripe Connect (creator payouts) — optional in Phase 0.
# STRIPE_CONNECT_CLIENT_ID=ca_...

# --- Cloudflare R2 (https://dash.cloudflare.com → R2) ---
# Create an R2 bucket, then an API token with Object R/W on it.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=drop-radar
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# Public read URL — either the r2.dev domain or a custom domain like https://cdn.dropradar.app
R2_PUBLIC_URL=https://cdn.dropradar.app

# --- Anthropic (Phase 1+: vision verify, AI vibe-coder) ---
# Free in Phase 0 — set when Phase 1 starts.
# ANTHROPIC_API_KEY=
