{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/upload-url.js": { "memory": 256, "maxDuration": 10 },
    "api/checkout.js": { "memory": 256, "maxDuration": 10 },
    "api/stripe-webhook.js": { "memory": 256, "maxDuration": 30 }
  },
  "crons": []
}
